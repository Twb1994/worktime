page {
  background: #f5f7fb;
  color: #1f2937;
  font-size: 32rpx;
}

.page {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.label {
  color: #4b5563;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

.input {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  box-sizing: border-box;
  height: 84rpx;
  margin-bottom: 22rpx;
  padding: 0 20rpx;
  width: 100%;
}

.row {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.btn {
  background: #1677ff;
  border-radius: 8rpx;
  color: #ffffff;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-light {
  background: #eef4ff;
  color: #1677ff;
}

.btn-danger {
  background: #fff1f2;
  color: #e11d48;
}

.muted {
  color: #6b7280;
  font-size: 26rpx;
}

.amount {
  color: #1677ff;
  font-size: 44rpx;
  font-weight: 700;
}

.empty {
  color: #9ca3af;
  padding: 60rpx 0;
  text-align: center;
}
