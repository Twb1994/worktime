.record-card {
  padding-bottom: 18rpx;
}

.picker-text {
  line-height: 84rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.record-name {
  font-size: 34rpx;
  font-weight: 700;
}

.record-pay {
  color: #1677ff;
  font-size: 36rpx;
  font-weight: 700;
}

.record-detail {
  color: #374151;
  font-size: 28rpx;
  margin: 18rpx 0;
}

.record-remark {
  background: #f9fafb;
  border-radius: 8rpx;
  color: #4b5563;
  font-size: 26rpx;
  margin-bottom: 18rpx;
  padding: 14rpx;
}

.remark-input {
  height: 140rpx;
  line-height: 44rpx;
  padding-top: 18rpx;
}

.record-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin: 0;
}
