<view class="page">
  <view class="title">记工记录</view>

  <view class="card search-card">
    <view class="label">搜索记录</view>
    <input class="input" value="{{searchQuery}}" placeholder="输入日期、工人、备注或金额" bindinput="onSearchInput" />
    <button wx:if="{{searchQuery}}" class="btn btn-light clear-btn" bindtap="clearSearch">清空搜索</button>
  </view>

  <view wx:if="{{editingId}}" class="card">
    <view class="section-title">编辑记录</view>

    <view class="label">日期</view>
    <picker mode="date" value="{{editForm.date}}" bindchange="onEditDateChange">
      <view class="input picker-text">{{editForm.date}}</view>
    </picker>

    <view class="label">正常工时</view>
    <input class="input" type="digit" value="{{editForm.normalHours}}" bindinput="onEditNormalHoursInput" />

    <view class="label">加班小时</view>
    <input class="input" type="digit" value="{{editForm.overtimeHours}}" bindinput="onEditOvertimeHoursInput" />

    <view class="label">备注</view>
    <textarea class="input remark-input" value="{{editForm.remark}}" bindinput="onEditRemarkInput" />

    <view class="record-actions">
      <button class="btn action-btn" bindtap="saveEdit">保存修改</button>
      <button class="btn btn-light action-btn" bindtap="cancelEdit">取消</button>
    </view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty">{{searchQuery ? '没有匹配的记录' : '还没有记录'}}</view>

  <view wx:for="{{records}}" wx:key="id" class="card record-card">
    <view class="row">
      <view>
        <view class="record-name">{{item.workerName}}</view>
        <view class="muted">{{item.date}}</view>
      </view>
      <view class="record-pay">¥{{item.pay}}</view>
    </view>
    <view class="record-detail">
      正常 {{item.normalHours}} 小时，加班 {{item.overtimeHours}} 小时
    </view>
    <view wx:if="{{item.remark}}" class="record-remark">备注：{{item.remark}}</view>
    <view class="record-actions">
      <button class="btn btn-light action-btn" data-id="{{item.id}}" bindtap="editRecord">编辑</button>
      <button class="btn btn-danger action-btn" data-id="{{item.id}}" bindtap="deleteRecord">删除</button>
    </view>
  </view>
</view>
