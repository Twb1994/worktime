<view class="page">
  <view class="title">今天记工</view>

  <view class="card">
    <view class="label">日期</view>
    <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
      <view class="input picker-text">{{form.date}}</view>
    </picker>

    <view class="label">工人</view>
    <picker range="{{workerNames}}" value="{{workerIndex}}" bindchange="onWorkerChange">
      <view class="input picker-text">{{currentWorker.name}}</view>
    </picker>

    <view class="label">正常工时</view>
    <input class="input" type="digit" value="{{form.normalHours}}" placeholder="例如 8" bindinput="onNormalHoursInput" />

    <view class="row overtime-row">
      <view>
        <view class="label">是否加班</view>
        <view class="muted">开启后填写加班小时</view>
      </view>
      <switch checked="{{form.hasOvertime}}" bindchange="onOvertimeSwitch" />
    </view>

    <block wx:if="{{form.hasOvertime}}">
      <view class="label">加班小时</view>
      <input class="input" type="digit" value="{{form.overtimeHours}}" placeholder="例如 2" bindinput="onOvertimeHoursInput" />
    </block>

    <view class="label">备注</view>
    <textarea class="input remark-input" value="{{form.remark}}" placeholder="例如 工地名称、工作内容" bindinput="onRemarkInput" />

    <view class="preview">
      <view class="muted">预计工资</view>
      <view class="amount">¥{{previewPay}}</view>
    </view>

    <button class="btn" bindtap="saveRecord">保存记录</button>
  </view>
</view>
